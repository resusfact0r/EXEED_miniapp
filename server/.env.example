DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tg_miniapp?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Telegram bot token used to validate Mini App initData (HMAC check)
TELEGRAM_BOT_TOKEN=

# DEV ONLY: when true, falls back to unsigned initData parsing if HMAC validation fails.
# Required for local dev against src/mockEnv.ts fake initData. Never set true in production.
ALLOW_UNSAFE_INIT_DATA=false

# Public URL of the Mini App - used in the /start reply's "Open catalog" button.
MINIAPP_URL="https://exeedbot.ru"

# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token header on every
# webhook call (set via the secret_token param when registering setWebhook). Leave empty only
# for local testing - without it, POST /api/bot/webhook accepts any caller.
TELEGRAM_WEBHOOK_SECRET=

# How the bot receives updates. Polling (getUpdates) only needs OUTBOUND access, so it works
# where a webhook can't - e.g. when Telegram cannot resolve/reach our domain. Off by default:
# without reachable Telegram it would just retry into the void every 5s.
TELEGRAM_BOT_POLLING=false

# HTTP(S) proxy used ONLY for api.telegram.org requests (everything else goes out directly).
# Needed on hosts where Telegram is blocked - e.g. this project's Russian VPS, where api.cdek.ru
# and google.com respond fine but api.telegram.org times out on both IPv4 and IPv6.
# Format: http://user:pass@host:port
TELEGRAM_PROXY_URL=

# Static token required in the X-Admin-Token header for /api/admin/* routes
ADMIN_API_TOKEN=devtoken

# CDEK API v2 credentials (OAuth2 client-credentials). Note: api.edu.cdek.ru is CDEK's
# separate sandbox contour with its own test credentials - production client_id/secret only
# work against api.cdek.ru.
CDEK_API_BASE_URL="https://api.cdek.ru"
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# false = call the real CDEK API, true/unset = return fixture PVZ data
CDEK_MOCKED=true

# Yandex Delivery API. Key is a Yandex OAuth token (y0__...), sent as a Bearer token.
# Pickup points come from POST /api/b2b/platform/pickup-points/list - note that endpoint
# ignores text filters (locality/city) and only honours a numeric Yandex geo_id, so the service
# fetches the whole country once (~25MB, 13k points), caches the normalized list and filters by
# city name itself.
YANDEX_DELIVERY_API_BASE_URL="https://b2b-authproxy.taxi.yandex.net"
YANDEX_DELIVERY_API_KEY=
# false = call the real Yandex Delivery API, true/unset = return fixture PVZ data
YANDEX_MOCKED=true

# Webhook URL the external order-processing system listens on (extension point)
EXTERNAL_ORDER_WEBHOOK_URL=

# Avtoliga Parts supplier API (live price/stock lookup at order time)
AVTOLIGA_API_BASE_URL="https://avtoliga-parts.ru/api/v1"
AVTOLIGA_API_TOKEN=
AVTOLIGA_ADDRESS_ID=
# Only Prices/Vendor entries matching this brand are trusted (a raw Articul can collide across vendors)
AVTOLIGA_VENDOR_FILTER=CHERY
# Markup applied on top of Avtoliga's raw price to get our shop price
AVTOLIGA_MARKUP_PERCENT=14
