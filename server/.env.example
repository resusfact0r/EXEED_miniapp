DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tg_miniapp?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Telegram bot token used to validate Mini App initData (HMAC check)
TELEGRAM_BOT_TOKEN=

# DEV ONLY: when true, falls back to unsigned initData parsing if HMAC validation fails.
# Required for local dev against src/mockEnv.ts fake initData. Never set true in production.
ALLOW_UNSAFE_INIT_DATA=false

# Public URL of the Mini App - used in the /start reply's "Open catalog" button.
MINIAPP_URL="https://exeedbot.ru"

# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token header on every
# webhook call (set via the secret_token param when registering setWebhook). Leave empty only
# for local testing - without it, POST /api/bot/webhook accepts any caller.
TELEGRAM_WEBHOOK_SECRET=

# How the bot receives updates. Polling (getUpdates) only needs OUTBOUND access, so it works
# where a webhook can't - e.g. when Telegram cannot resolve/reach our domain. Off by default:
# without reachable Telegram it would just retry into the void every 5s.
TELEGRAM_BOT_POLLING=false

# HTTP(S) proxy used ONLY for api.telegram.org requests (everything else goes out directly).
# Needed on hosts where Telegram is blocked - e.g. this project's Russian VPS, where api.cdek.ru
# and google.com respond fine but api.telegram.org times out on both IPv4 and IPv6.
# Format: http://user:pass@host:port
TELEGRAM_PROXY_URL=

# Static token required in the X-Admin-Token header for /api/admin/* routes
ADMIN_API_TOKEN=devtoken

# CDEK API v2 credentials (OAuth2 client-credentials). Note: api.edu.cdek.ru is CDEK's
# separate sandbox contour with its own test credentials - production client_id/secret only
# work against api.cdek.ru.
CDEK_API_BASE_URL="https://api.cdek.ru"
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# false = call the real CDEK API, true/unset = return fixture PVZ data
CDEK_MOCKED=true

# Yandex Delivery API. Key is a Yandex OAuth token (y0__...), sent as a Bearer token.
# Pickup points come from POST /api/b2b/platform/pickup-points/list - note that endpoint
# ignores text filters (locality/city) and only honours a numeric Yandex geo_id, so the service
# fetches the whole country once (~25MB, 13k points), caches the normalized list and filters by
# city name itself.
YANDEX_DELIVERY_API_BASE_URL="https://b2b-authproxy.taxi.yandex.net"
YANDEX_DELIVERY_API_KEY=
# false = call the real Yandex Delivery API, true/unset = return fixture PVZ data
YANDEX_MOCKED=true

# Webhook URL the external order-processing system listens on (extension point)
EXTERNAL_ORDER_WEBHOOK_URL=

# Telegram chat ids (comma-separated) that get a message for every new order. Every order is
# created as NEW and needs a payment link issued by hand, so without this the queue is only
# visible by polling GET /api/admin/orders. Send /id to the bot to learn a chat's id.
ORDER_NOTIFY_CHAT_IDS=

# Telegram chat that receives the nightly database dump (deploy/backup/). Owner only: the dump
# holds customers' phone numbers, so it deliberately isn't sent to ORDER_NOTIFY_CHAT_IDS.
BACKUP_CHAT_ID=

# Where parcels start from, for delivery-time estimates: CDEK city code (44 = Москва) and a
# free-text address for Yandex's calculator.
CDEK_FROM_CITY_CODE=44
YANDEX_SOURCE_ADDRESS=Москва

# Avtoliga Parts supplier API (live price/stock lookup at order time)
AVTOLIGA_API_BASE_URL="https://avtoliga-parts.ru/api/v1"
AVTOLIGA_API_TOKEN=
AVTOLIGA_ADDRESS_ID=
# Only Prices/Vendor entries matching this brand are trusted (a raw Articul can collide across vendors)
AVTOLIGA_VENDOR_FILTER=CHERY
# Markup applied on top of Avtoliga's raw price to get our shop price
AVTOLIGA_MARKUP_PERCENT=14

# Supplier price list emailed as Excel several times a day (src/price-sync). The mailbox is opened
# read-only - nothing is marked read or deleted. Use an app password, not the account password.
PRICE_SYNC_ENABLED=false
PRICE_SYNC_INTERVAL_MIN=10
PRICE_IMAP_USER=
PRICE_IMAP_PASSWORD=
# Derived from the mailbox domain for Gmail/Yandex/Mail.ru; set for anything else.
PRICE_IMAP_HOST=
PRICE_IMAP_PORT=993
# Only emails from this sender (optionally with this text in the subject) are treated as price lists.
PRICE_MAIL_FROM=
PRICE_MAIL_SUBJECT=
# Folders to look in. Default: Gmail's "All Mail" (inbox + archive + labels) and Spam, found by
# their IMAP special-use flags - so the sender can be filtered out of the inbox or even blocked.
PRICE_MAIL_FOLDERS=
# Who gets the import reports; defaults to BACKUP_CHAT_ID.
PRICE_REPORT_CHAT_ID=

# Watchdog (deploy/watchdog, runs from systemd, reads this file). Alerts go to WATCHDOG_CHAT_ID
# (default BACKUP_CHAT_ID); when Telegram is unreachable, by email via Gmail SMTP using the price
# mailbox's app password unless WATCHDOG_SMTP_* are set.
WATCHDOG_CHAT_ID=
WATCHDOG_EMAIL=
# Alert when no price list was applied for this many Mon-Fri hours.
WATCHDOG_PRICE_STALE_BUSINESS_HOURS=80
# Remind operators about an order still waiting for a payment link after this many hours.
WATCHDOG_ORDER_REMIND_HOURS=2
# Optional dead man's switch, e.g. a healthchecks.io ping URL.
WATCHDOG_PING_URL=

# The seller, shown to customers. Until name, OGRN(IP), INN and address are set, the legal
# documents, the "О продавце" block and the personal data consent stay off. A name starting with
# "ИП"/"Индивидуальный предприниматель" is shown with ОГРНИП. Without SELLER_EMAIL, customers are
# pointed to the bot chat for requests.
SELLER_NAME=
SELLER_OGRN=
SELLER_INN=
SELLER_ADDRESS=
SELLER_EMAIL=
SELLER_PHONE=
# Bank details for the terms of sale, one line.
SELLER_BANK=
