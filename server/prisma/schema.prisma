generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum PickupAddress {
  ADDRESS_1
  ADDRESS_2
}

enum DeliveryCarrier {
  CDEK
  YANDEX
}

enum PaymentMethod {
  QR_LINK
  LEGAL_ENTITY
}

enum OrderStatus {
  NEW
  AWAITING_PAYMENT_LINK
  AWAITING_PAYMENT
  PAID
  /// Ordered from the supplier (/work).
  IN_PROGRESS
  /// Pickup orders: waiting at the pickup address (/ready).
  READY_FOR_PICKUP
  /// Delivery orders: handed to the carrier, trackingNumber set (/ship).
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id          String     @id @default(cuid())
  telegramId  BigInt     @unique
  username    String?
  firstName   String?
  lastName    String?
  phone       String?
  /// When the customer accepted the personal data consent (/api/legal/consent).
  pdConsentAt DateTime?
  firstSeenAt DateTime   @default(now())
  lastSeenAt  DateTime   @updatedAt
  cartItems   CartItem[]
  orders      Order[]

  /// Checkout pre-fills from these when set, but the user can always change them per order -
  /// this is just a convenience default, not an enforced setting.
  preferredFulfillmentType FulfillmentType?
  preferredDeliveryCarrier DeliveryCarrier?
  preferredPaymentMethod   PaymentMethod?
}

model Product {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  price       Decimal     @db.Decimal(10, 2)
  stockQty    Int         @default(0)
  /// Supplier's minimum lot ("Минимальная партия" / InPackage): the price is per piece, but only
  /// whole multiples of this can be bought - so the cart only allows multiples too.
  packQty     Int         @default(1)
  description String?
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([name])
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  /// Price the customer last saw for this line: set when it's added and moved forward once the
  /// cart or checkout screen has shown a change (POST /cart/acknowledge-prices). The cart warns
  /// when the catalog price differs - with prices updating from email several times a day,
  /// comparing against the price at first add kept the warning on forever.
  priceAtAdd Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, productId])
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int         @default(autoincrement())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  status       OrderStatus @default(NEW)

  fulfillmentType    FulfillmentType
  pickupAddressCode  PickupAddress?
  pickupAddressLabel String?
  deliveryCarrier    DeliveryCarrier?
  deliveryPvzId      String?
  deliveryPvzAddress String?

  paymentMethod  PaymentMethod
  orgCardDetails String?       @db.Text
  paymentLink    String?
  /// Exact delivery cost the operator charged in /pay (delivery orders only). The customer
  /// pays totalAmount + deliveryCost; totalAmount stays the goods' total.
  deliveryCost   Decimal?      @db.Decimal(10, 2)
  trackingNumber String?
  cancelReason   String?

  policyAcknowledgedAt DateTime
  totalAmount          Decimal  @db.Decimal(10, 2)

  externalNotifiedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  items              OrderItem[]
  statusChanges      OrderStatusChange[]

  @@unique([orderNumber])
}

/// Every status an order went through and when - shown to the operator by /order.
model OrderStatusChange {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productCode String
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
}

enum PriceImportStatus {
  /// Prices and stock written to the catalog.
  APPLIED
  /// File read but not applied: failed a safety check (too few rows, missing columns, junk prices).
  REJECTED
  /// An older email superseded by a newer one in the same run - only the latest price list matters.
  SKIPPED
  /// Unexpected error while processing.
  FAILED
}

/// One price list processed from the supplier's emailed Excel (or loaded by hand from a file).
/// Message-ID makes reprocessing the same email impossible; the counts are the audit trail.
model PriceImport {
  id         String            @id @default(cuid())
  source     String
  messageUid Int?
  messageId  String?           @unique
  receivedAt DateTime?
  fileName   String?
  rows       Int               @default(0)
  updated    Int               @default(0)
  added      Int               @default(0)
  hidden     Int               @default(0)
  restored   Int               @default(0)
  status     PriceImportStatus
  error      String?           @db.Text
  createdAt  DateTime          @default(now())

  @@index([messageUid])
}

// Guest orders use a random per-order access key, separate from Telegram identities.
model WebOrder {
  number         Int         @id @default(autoincrement())
  accessHash     String      @unique
  requestHash    String
  state          String
  name           String
  phone          String
  vin            String?
  items          Json
  goodsCents     Int
  deliveryCents  Int?
  city           Int?
  point          String?
  address        String
  parcel         Json?
  attempt        Int         @default(1)
  paymentSince   DateTime?
  paymentId      String?     @unique
  paymentUrl     String?
  shipmentId     String?
  tracking       String?
  labelId        String?
  carrierStatus  String?
  claimHash      String?     @unique
  claimUntil     DateTime?
  chat           String?
  notice         String?
  checkedAt      DateTime    @default(now())
  consentAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([state, checkedAt])
}
